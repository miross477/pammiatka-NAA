<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scrollView1"
    android:paddingLeft="@dimen/activity_horizontal_margin"
    android:paddingTop="@dimen/activity_vertical_margin"
    android:paddingRight="@dimen/activity_horizontal_margin"
    android:paddingBottom="@dimen/activity_vertical_margin"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textAppearance="@style/TextAppearance.AppCompat.Large"
            android:gravity="center_horizontal"
            android:id="@+id/textView322"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/namestat41"
            android:layout_alignParentTop="true"
            android:layout_alignParentStart="true"
            android:layout_alignParentEnd="true"/>
        <TextView
            android:textAppearance="@style/TextAppearance.AppCompat.Body2"
            android:id="@+id/textView2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/koap135"
            android:layout_below="@+id/textView322"
            android:layout_alignParentStart="true"/>
        <Button
            android:textColor="#ffffff"
            android:gravity="center"
            android:id="@+id/button2"
            android:background="@android:color/holo_orange_dark"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/doc1"
            android:drawablePadding="5dp"
            android:layout_below="@+id/textView2"
            android:onClick="newScreen"
            android:drawableStart="@drawable/icons724"
            android:layout_alignEnd="@+id/textView2"
            android:layout_alignParentStart="true"
            android:paddingHorizontal="30dp"/>
        <Button
            android:textColor="#ffffff"
            android:gravity="center"
            android:id="@+id/button9"
            android:background="@android:color/holo_green_dark"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="РАСЧЕТ"
            android:drawablePadding="5dp"
            android:layout_below="@+id/button2"
            android:onClick="newScreen2"
            android:drawableStart="@drawable/icons824"
            android:layout_alignParentStart="true"
            android:layout_alignParentEnd="true"
            android:paddingHorizontal="30dp"/>
        <Button
            android:textColor="#ffffff"
            android:gravity="center"
            android:id="@+id/pdfbtn"
            android:background="@color/colorAccent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="ВСТУПЛЕНИЕ В СИЛУ"
            android:drawablePadding="5dp"
            android:layout_below="@+id/button9"
            android:onClick="newScreen2"
            android:drawableStart="@drawable/icons24"
            android:layout_alignParentStart="true"
            android:layout_alignParentEnd="true"
            android:paddingHorizontal="30dp"/>
    </RelativeLayout>
</ScrollView>

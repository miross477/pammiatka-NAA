<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/activity_main462"
    android:background="#eaead6"
    android:paddingLeft="@dimen/activity_horizontal_margin"
    android:paddingTop="@dimen/activity_vertical_margin"
    android:paddingRight="@dimen/activity_horizontal_margin"
    android:paddingBottom="@dimen/activity_vertical_margin"
    android:clickable="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <Button
            android:id="@+id/button1"
            android:background="#2196f3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ЛЕГКОВЫЕ АВТО"
            android:onClick="newScreen1"
            android:layout_alignParentStart="true"/>
        <Button
            android:textAppearance="@style/TextAppearance.AppCompat.Body2"
            android:id="@+id/button2"
            android:background="#64b5f6"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="ГРУЗОВЫЕ АВТО"
            android:layout_below="@+id/button1"
            android:onClick="newScreen2"
            android:layout_alignParentEnd="true"/>
        <Button
            android:textSize="14sp"
            android:id="@+id/button3"
            android:background="#4fc3f7"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="АВТОБУСЫ И ИНЫЕ"
            android:layout_below="@+id/button2"
            android:onClick="newScreen3"
            android:layout_alignParentStart="true"/>
        <Button
            android:textSize="14sp"
            android:id="@+id/button4"
            android:background="#4dd0e1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="МОТО"
            android:layout_below="@+id/button3"
            android:onClick="newScreen4"
            android:layout_alignParentStart="true"/>
        <Button
            android:textSize="14sp"
            android:id="@+id/button5"
            android:background="#4db6ac"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="ПРИЦЕПЫ"
            android:layout_below="@+id/button4"
            android:onClick="newScreen5"
            android:layout_alignParentStart="true"/>
    </RelativeLayout>
</ScrollView>

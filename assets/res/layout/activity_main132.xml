<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/scrollView1"
    android:paddingLeft="@dimen/activity_horizontal_margin"
    android:paddingTop="@dimen/activity_vertical_margin"
    android:paddingRight="@dimen/activity_horizontal_margin"
    android:paddingBottom="@dimen/activity_vertical_margin"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textAppearance="@style/TextAppearance.AppCompat.Body2"
            android:textStyle="bold"
            android:gravity="center"
            android:id="@+id/dateTimeTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Placeholder text"
            android:layout_alignParentStart="true"/>
        <TextView
            android:textAppearance="@style/TextAppearance.AppCompat.Body2"
            android:id="@+id/textView108"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/fabul61"
            android:layout_below="@+id/dateTimeTextView"
            android:layout_alignParentStart="true"/>
        <ImageView
            android:id="@+id/imageView5"
            android:background="@android:drawable/btn_default_small"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_marginTop="5dp"
            android:src="@drawable/znak31"
            android:layout_below="@+id/textView108"
            android:contentDescription="@string/desc"/>
        <TextView
            android:textAppearance="@style/TextAppearance.AppCompat.Body2"
            android:gravity="start|center_vertical"
            android:id="@+id/textView"
            android:background="@android:drawable/btn_default"
            android:layout_width="159dp"
            android:layout_height="50dp"
            android:text="@string/text221"
            android:layout_toRightOf="@+id/imageView5"
            android:layout_above="@+id/textView1"
            android:layout_alignParentRight="true"
            android:fadeScrollbars="true"
            android:layout_toEndOf="@+id/imageView5"
            android:layout_alignParentEnd="true"/>
        <ImageView
            android:id="@+id/imageView6"
            android:background="@android:drawable/btn_default_small"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:src="@drawable/znak571"
            android:layout_below="@+id/imageView5"
            android:layout_alignParentLeft="true"
            android:contentDescription="@string/desc"
            android:layout_alignParentStart="true"/>
        <ImageView
            android:id="@+id/imageView9"
            android:background="@android:drawable/btn_default_small"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:src="@drawable/znak572"
            android:layout_below="@+id/imageView6"
            android:layout_alignParentLeft="true"
            android:contentDescription="@string/desc"
            android:layout_alignParentStart="true"/>
        <TextView
            android:textAppearance="@style/TextAppearance.AppCompat.Body2"
            android:gravity="start|center_vertical"
            android:id="@+id/textView229"
            android:background="@android:drawable/btn_default"
            android:layout_width="159dp"
            android:layout_height="50dp"
            android:text="@string/text222"
            android:layout_toRightOf="@+id/imageView6"
            android:layout_below="@+id/imageView6"
            android:layout_alignParentRight="true"
            android:fadeScrollbars="true"
            android:layout_toEndOf="@+id/imageView6"
            android:layout_alignParentEnd="true"/>
        <TextView
            android:textAppearance="@style/TextAppearance.AppCompat.Body2"
            android:gravity="start|center_vertical"
            android:id="@+id/textView1"
            android:background="@android:drawable/btn_default"
            android:layout_width="159dp"
            android:layout_height="50dp"
            android:text="@string/text223"
            android:layout_toRightOf="@+id/imageView5"
            android:layout_above="@+id/textView229"
            android:layout_alignParentRight="true"
            android:fadeScrollbars="true"
            android:layout_toEndOf="@+id/imageView5"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
</ScrollView>

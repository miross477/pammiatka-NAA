<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:paddingLeft="@dimen/activity_horizontal_margin"
    android:paddingTop="@dimen/activity_vertical_margin"
    android:paddingRight="@dimen/activity_horizontal_margin"
    android:paddingBottom="@dimen/activity_vertical_margin"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <Button
        android:id="@+id/button48"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/statmenu1"
        android:layout_alignParentTop="false"
        android:onClick="newScreen"
        android:layout_alignParentStart="true"
        android:layout_alignParentEnd="true"/>
    <Button
        android:id="@+id/button49"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/statmenu2"
        android:layout_below="@+id/button48"
        android:onClick="newScreen1"
        android:layout_alignEnd="@+id/button48"
        android:layout_alignParentStart="true"/>
    <Button
        android:id="@+id/button50"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/statmenu3"
        android:layout_below="@+id/button49"
        android:onClick="newScreen2"
        android:layout_alignParentStart="true"/>
    <Button
        android:id="@+id/button51"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/statmenu4"
        android:layout_below="@+id/button50"
        android:onClick="newScreen3"
        android:layout_alignEnd="@+id/button50"
        android:layout_alignParentStart="true"/>
</RelativeLayout>

<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingLeft="@dimen/activity_horizontal_margin"
    android:paddingTop="@dimen/activity_vertical_margin"
    android:paddingRight="@dimen/activity_horizontal_margin"
    android:paddingBottom="@dimen/activity_vertical_margin"
    android:clickable="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textAppearance="@style/TextAppearance.AppCompat.Body2"
            android:textStyle="bold"
            android:gravity="center"
            android:id="@+id/dateTimeTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Placeholder text"
            android:layout_alignParentStart="true"/>
        <TextView
            android:textAppearance="@style/TextAppearance.AppCompat.Body2"
            android:id="@+id/textView39"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/fabul151"
            android:layout_below="@+id/dateTimeTextView"
            android:layout_alignParentStart="true"/>
        <Button
            android:textColor="#ffffff"
            android:id="@+id/button6"
            android:background="@color/colorPrimaryDark"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/text312"
            android:layout_below="@+id/textView39"
            android:onClick="newScreen3"
            android:layout_alignParentStart="true"
            android:layout_alignParentEnd="true"/>
        <TextView
            android:textAppearance="@style/TextAppearance.AppCompat.Body2"
            android:id="@+id/textView40"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/fabul300"
            android:layout_below="@+id/button6"
            android:layout_alignParentTop="false"
            android:layout_alignParentStart="true"
            android:layout_alignParentEnd="true"/>
        <Button
            android:id="@+id/button2"
            android:background="@android:color/holo_green_light"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/doc24"
            android:layout_below="@+id/textView40"
            android:onClick="newScreen"
            android:layout_marginEnd="5dp"
            android:layout_toStartOf="@+id/button22"
            android:layout_alignParentStart="true"/>
        <Button
            android:textColor="#ffffff"
            android:id="@+id/button22"
            android:background="@android:color/holo_blue_dark"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/doc22"
            android:layout_below="@+id/textView40"
            android:layout_centerHorizontal="true"
            android:onClick="newScreen1"
            android:layout_marginEnd="5dp"/>
        <Button
            android:textColor="#ffffff"
            android:id="@+id/button3"
            android:background="@android:color/holo_red_light"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/doc23"
            android:layout_below="@+id/textView40"
            android:onClick="newScreen2"
            android:layout_toEndOf="@+id/button22"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
</ScrollView>

<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scrollView1"
    android:paddingLeft="@dimen/activity_horizontal_margin"
    android:paddingTop="@dimen/activity_vertical_margin"
    android:paddingRight="@dimen/activity_horizontal_margin"
    android:paddingBottom="@dimen/activity_vertical_margin"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textAppearance="@style/TextAppearance.AppCompat.Large"
            android:gravity="center_horizontal"
            android:id="@+id/textView225"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/namestat15"
            android:layout_alignParentTop="true"/>
        <TextView
            android:textAppearance="@style/TextAppearance.AppCompat.Body2"
            android:id="@+id/textView2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:singleLine="false"
            android:layout_below="@+id/textView225"
            android:layout_alignParentStart="true"
            android:breakStrategy="high_quality"
            android:hyphenationFrequency="normal"/>
        <Button
            android:id="@+id/button2"
            android:background="@android:color/holo_orange_light"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/doc1"
            android:layout_below="@+id/textView2"
            android:onClick="newScreen"
            android:layout_marginEnd="5dp"
            android:layout_toStartOf="@+id/button3"
            android:layout_alignParentStart="true"/>
        <Button
            android:textAppearance="@style/TextAppearance.AppCompat.Body2"
            android:textColor="#ffffff"
            android:id="@+id/button3"
            android:background="@android:color/holo_blue_dark"
            android:padding="10dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/PDD1"
            android:layout_below="@+id/textView2"
            android:onClick="newScreen1"
            android:layout_alignParentEnd="true"/>
        <Button
            android:textSize="14sp"
            android:textColor="#ffffff"
            android:id="@+id/button8"
            android:background="@android:color/holo_green_dark"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/text201"
            android:layout_below="@+id/button3"
            android:layout_alignParentStart="true"
            android:layout_alignParentEnd="true"/>
        <Button
            android:textSize="14sp"
            android:textColor="#ffffff"
            android:id="@+id/button22"
            android:background="@color/colorPrimaryDark"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/postprav"
            android:layout_below="@+id/button8"
            android:onClick="newScreen4"
            android:layout_alignParentStart="true"
            android:layout_alignParentEnd="true"/>
        <TextView
            android:textAppearance="@style/TextAppearance.AppCompat.Body2"
            android:id="@+id/textView3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:singleLine="false"
            android:layout_below="@+id/button22"
            android:layout_alignParentStart="true"
            android:breakStrategy="high_quality"
            android:hyphenationFrequency="normal"/>
        <Button
            android:id="@+id/button4"
            android:background="@android:color/holo_orange_dark"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/doc2"
            android:layout_below="@+id/textView3"
            android:onClick="newScreen2"
            android:layout_marginEnd="5dp"
            android:layout_toStartOf="@+id/button5"
            android:layout_alignParentStart="true"/>
        <Button
            android:textAppearance="@style/TextAppearance.AppCompat.Body2"
            android:textColor="#ffffff"
            android:id="@+id/button5"
            android:background="@android:color/holo_blue_dark"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/PDD2"
            android:layout_below="@+id/textView3"
            android:onClick="newScreen3"
            android:layout_alignParentEnd="true"/>
        <Button
            android:textColor="#ffffff"
            android:id="@+id/button9"
            android:background="@android:color/holo_green_dark"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/text202"
            android:layout_below="@+id/button4"
            android:layout_alignParentStart="true"
            android:layout_alignParentEnd="true"/>
        <TextView
            android:textAppearance="@style/TextAppearance.AppCompat.Body2"
            android:id="@+id/textView4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:singleLine="false"
            android:layout_below="@+id/button9"
            android:layout_alignParentStart="true"
            android:breakStrategy="high_quality"
            android:hyphenationFrequency="normal"/>
        <Button
            android:textSize="14sp"
            android:textColor="#ffffff"
            android:id="@+id/button23"
            android:background="@color/colorPrimaryDark"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/postprav"
            android:layout_below="@+id/textView4"
            android:onClick="newScreen5"
            android:layout_alignParentStart="true"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
</ScrollView>

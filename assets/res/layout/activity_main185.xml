<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scrollView1"
    android:paddingLeft="@dimen/activity_horizontal_margin"
    android:paddingTop="@dimen/activity_vertical_margin"
    android:paddingRight="@dimen/activity_horizontal_margin"
    android:paddingBottom="@dimen/activity_vertical_margin"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textAppearance="@style/TextAppearance.AppCompat.Large"
            android:gravity="center_horizontal"
            android:id="@+id/textView221"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/namestat11"
            android:layout_alignParentTop="true"
            android:layout_alignParentRight="true"
            android:layout_alignParentStart="true"
            android:layout_alignParentEnd="true"/>
        <TextView
            android:textAppearance="@style/TextAppearance.AppCompat.Body2"
            android:id="@+id/textView2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/koap99"
            android:layout_below="@+id/textView221"
            android:layout_alignParentStart="true"/>
        <Button
            android:id="@+id/button2"
            android:background="@android:color/holo_orange_light"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/doc1"
            android:layout_below="@+id/textView2"
            android:onClick="newScreen"
            android:layout_marginEnd="5dp"
            android:layout_toStartOf="@+id/button3"
            android:layout_alignParentStart="true"/>
        <Button
            android:textAppearance="@style/TextAppearance.AppCompat.Body2"
            android:textColor="#ffffff"
            android:id="@+id/button3"
            android:background="@android:color/holo_blue_dark"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/PDD48"
            android:layout_alignBottom="@+id/button2"
            android:onClick="newScreen1"
            android:layout_alignEnd="@+id/textView2"/>
        <TextView
            android:textAppearance="@style/TextAppearance.AppCompat.Body2"
            android:id="@+id/textView3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/koap100"
            android:layout_below="@+id/button2"
            android:layout_alignParentRight="true"
            android:layout_alignParentStart="true"
            android:layout_alignParentEnd="true"/>
        <Button
            android:id="@+id/button4"
            android:background="@android:color/holo_orange_light"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/doc2"
            android:layout_below="@+id/textView3"
            android:onClick="newScreen3"
            android:layout_marginEnd="5dp"
            android:layout_toStartOf="@+id/button5"
            android:layout_alignParentStart="true"/>
        <Button
            android:textAppearance="@style/TextAppearance.AppCompat.Body2"
            android:textColor="#ffffff"
            android:id="@+id/button5"
            android:background="@android:color/holo_blue_dark"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/PDD49"
            android:layout_below="@+id/textView3"
            android:onClick="newScreen4"
            android:layout_alignParentEnd="true"/>
        <TextView
            android:textAppearance="@style/TextAppearance.AppCompat.Body2"
            android:id="@+id/textView4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/koap101"
            android:layout_below="@+id/button4"
            android:layout_alignParentRight="true"
            android:textIsSelectable="false"
            android:layout_toStartOf="@+id/button5"
            android:layout_alignParentStart="true"
            android:layout_alignParentEnd="true"/>
        <Button
            android:id="@+id/button6"
            android:background="@android:color/holo_orange_light"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/doc3"
            android:layout_below="@+id/textView4"
            android:onClick="newScreen5"
            android:layout_marginEnd="5dp"
            android:layout_toStartOf="@+id/button7"
            android:layout_alignParentStart="true"/>
        <Button
            android:textAppearance="@style/TextAppearance.AppCompat.Body2"
            android:textColor="#ffffff"
            android:id="@+id/button7"
            android:background="@android:color/holo_blue_dark"
            android:padding="10dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/PDD50"
            android:layout_below="@+id/textView4"
            android:onClick="newScreen6"
            android:layout_alignParentEnd="true"/>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/layout_part3_extra"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_below="@+id/button6">
            <Button
                android:textColor="#ffffff"
                android:id="@+id/buttonNpd"
                android:background="#6a5acd"
                android:padding="12dp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Налог на ПД"
                android:layout_weight="1"
                android:onClick="openNpd"/>
            <Button
                android:textColor="#ffffff"
                android:id="@+id/buttonInnFio"
                android:background="#2e7d32"
                android:padding="12dp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="ИНН по ФИО"
                android:layout_weight="1"
                android:onClick="openInnByFio"
                android:layout_marginStart="6dp"/>
        </LinearLayout>
        <TextView
            android:textAppearance="@style/TextAppearance.AppCompat.Body2"
            android:id="@+id/textView5"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/koap1011"
            android:layout_below="@+id/layout_part3_extra"
            android:textIsSelectable="false"
            android:layout_toStartOf="@+id/button7"
            android:layout_alignParentStart="true"
            android:layout_alignParentEnd="true"/>
        <Button
            android:id="@+id/button8"
            android:background="@android:color/holo_orange_light"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/doc3"
            android:layout_below="@+id/textView5"
            android:onClick="newScreen7"
            android:layout_toStartOf="@+id/button7"
            android:layout_alignEnd="@+id/button4"
            android:layout_alignParentStart="true"/>
        <Button
            android:textAppearance="@style/TextAppearance.AppCompat.Body2"
            android:textColor="#ffffff"
            android:id="@+id/button9"
            android:background="@android:color/holo_blue_dark"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/PDD501"
            android:layout_below="@+id/textView5"
            android:onClick="newScreen8"
            android:layout_alignParentEnd="true"/>
        <TextView
            android:textAppearance="@style/TextAppearance.AppCompat.Body2"
            android:id="@+id/textView6"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/koap1012"
            android:layout_below="@+id/button8"
            android:textIsSelectable="false"
            android:layout_toStartOf="@+id/button9"
            android:layout_alignParentStart="true"
            android:layout_alignParentEnd="true"/>
        <Button
            android:id="@+id/button10"
            android:background="@android:color/holo_orange_dark"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/doc3"
            android:layout_below="@+id/textView6"
            android:onClick="newScreen9"
            android:layout_toStartOf="@+id/button7"
            android:layout_alignEnd="@+id/button8"
            android:layout_alignParentStart="true"/>
        <Button
            android:textAppearance="@style/TextAppearance.AppCompat.Body2"
            android:textColor="#ffffff"
            android:id="@+id/button11"
            android:background="@android:color/holo_blue_dark"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/PDD501"
            android:layout_below="@+id/textView6"
            android:onClick="newScreen8"
            android:layout_alignParentEnd="true"/>
        <TextView
            android:textAppearance="@style/TextAppearance.AppCompat.Body2"
            android:id="@+id/textView7"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/koap1013"
            android:layout_below="@+id/button10"
            android:textIsSelectable="false"
            android:layout_toStartOf="@+id/button11"
            android:layout_alignParentStart="true"
            android:layout_alignParentEnd="true"/>
        <Button
            android:id="@+id/button12"
            android:background="@android:color/holo_orange_light"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/doc3"
            android:layout_below="@+id/textView7"
            android:onClick="newScreen10"
            android:layout_toStartOf="@+id/button7"
            android:layout_alignEnd="@+id/button10"
            android:layout_alignParentStart="true"/>
        <Button
            android:textAppearance="@style/TextAppearance.AppCompat.Body2"
            android:textColor="#ffffff"
            android:id="@+id/button13"
            android:background="@android:color/holo_blue_dark"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/PDD501"
            android:layout_below="@+id/textView7"
            android:onClick="newScreen8"
            android:layout_alignParentEnd="true"/>
        <TextView
            android:textAppearance="@style/TextAppearance.AppCompat.Body2"
            android:id="@+id/textView8"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/koap1014"
            android:layout_below="@+id/button12"
            android:textIsSelectable="false"
            android:layout_toStartOf="@+id/button13"
            android:layout_alignParentStart="true"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
</ScrollView>

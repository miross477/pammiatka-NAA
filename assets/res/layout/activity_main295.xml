<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:paddingLeft="@dimen/activity_horizontal_margin"
    android:paddingTop="@dimen/activity_vertical_margin"
    android:paddingRight="@dimen/activity_horizontal_margin"
    android:paddingBottom="@dimen/activity_vertical_margin"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textAppearance="@style/TextAppearance.AppCompat.Large"
        android:gravity="center_horizontal"
        android:id="@+id/textView212"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/namestat45"
        android:layout_alignParentLeft="true"
        android:layout_alignParentTop="true"
        android:layout_alignParentRight="true"
        android:layout_alignParentStart="true"
        android:layout_alignParentEnd="true"/>
    <TextView
        android:textAppearance="@style/TextAppearance.AppCompat.Body2"
        android:id="@+id/textView2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/koap150"
        android:layout_below="@+id/textView212"
        android:layout_alignParentLeft="true"
        android:layout_alignParentStart="true"/>
    <Button
        android:id="@+id/button2"
        android:background="@android:color/holo_orange_light"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:layout_marginRight="5dp"
        android:text="@string/doc1"
        android:layout_toLeftOf="@+id/button3"
        android:layout_below="@+id/textView2"
        android:layout_alignParentLeft="true"
        android:onClick="newScreen"
        android:layout_marginEnd="5dp"
        android:layout_toStartOf="@+id/button3"
        android:layout_alignParentStart="true"/>
    <Button
        android:textColor="#ffffff"
        android:id="@+id/button3"
        android:background="@android:color/holo_blue_dark"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/nazv2"
        android:layout_alignRight="@+id/textView2"
        android:layout_alignBottom="@+id/button2"
        android:onClick="newScreen1"
        android:layout_alignEnd="@+id/textView2"/>
</RelativeLayout>

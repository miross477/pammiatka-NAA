<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/activity_main700"
    android:paddingLeft="@dimen/activity_horizontal_margin"
    android:paddingTop="@dimen/activity_vertical_margin"
    android:paddingRight="@dimen/activity_horizontal_margin"
    android:paddingBottom="@dimen/activity_vertical_margin"
    android:clickable="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TableLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textAppearance="@style/TextAppearance.AppCompat.Body2"
                android:id="@+id/textView700"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/algoritm1"/>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <Button
                android:textColor="@android:color/background_light"
                android:id="@+id/button82"
                android:background="@android:color/holo_blue_dark"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="2dp"
                android:layout_marginLeft="0dp"
                android:text="@string/algoritm2"
                android:onClick="newScreen2"
                android:layout_marginStart="0dp"/>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <Button
                android:textColor="@android:color/background_light"
                android:id="@+id/button80"
                android:background="@android:color/holo_red_light"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="2dp"
                android:layout_marginTop="4dp"
                android:text="@string/stat8"
                android:layout_weight="1"
                android:onClick="newScreen"/>
            <Button
                android:textAppearance="@style/TextAppearance.AppCompat.Body2"
                android:textColor="#ffffff"
                android:id="@+id/button81"
                android:background="@android:color/holo_red_dark"
                android:padding="10dp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="2dp"
                android:text="@string/stat26"
                android:layout_weight="1"
                android:onClick="newScreen1"/>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <Button
                android:textSize="14sp"
                android:textColor="#ffffff"
                android:id="@+id/button22"
                android:background="@color/colorPrimaryDark"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="2dp"
                android:layout_marginTop="4dp"
                android:text="@string/postprav"
                android:layout_weight="1"
                android:onClick="newScreen7"/>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textAppearance="@style/TextAppearance.AppCompat.Body2"
                android:id="@+id/textView701"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/algoritm10"/>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <Button
                android:textColor="@android:color/background_light"
                android:id="@+id/button83"
                android:background="@android:color/holo_blue_dark"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="2dp"
                android:text="@string/doc22"
                android:layout_weight="1"
                android:onClick="newScreen3"/>
            <Button
                android:textAppearance="@style/TextAppearance.AppCompat.Body2"
                android:textColor="#ffffff"
                android:id="@+id/button84"
                android:background="@android:color/holo_orange_dark"
                android:padding="10dp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="2dp"
                android:text="@string/text204"
                android:layout_weight="1"
                android:onClick="newScreen4"/>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textAppearance="@style/TextAppearance.AppCompat.Body2"
                android:id="@+id/textView702"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/algoritm11"/>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <Button
                android:textColor="@android:color/background_light"
                android:id="@+id/button85"
                android:background="@android:color/holo_blue_dark"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="2dp"
                android:text="@string/doc22"
                android:layout_weight="1"
                android:onClick="newScreen5"/>
            <Button
                android:textAppearance="@style/TextAppearance.AppCompat.Body2"
                android:textColor="#ffffff"
                android:id="@+id/button86"
                android:background="@android:color/holo_orange_dark"
                android:padding="10dp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="2dp"
                android:text="@string/text204"
                android:layout_weight="1"
                android:onClick="newScreen6"/>
        </LinearLayout>
    </TableLayout>
</ScrollView>

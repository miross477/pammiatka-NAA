<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/activity_main504"
    android:paddingLeft="@dimen/activity_horizontal_margin"
    android:paddingTop="@dimen/activity_vertical_margin"
    android:paddingRight="@dimen/activity_horizontal_margin"
    android:paddingBottom="@dimen/activity_vertical_margin"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textAppearance="@style/TextAppearance.AppCompat.Body2"
        android:textStyle="bold"
        android:gravity="center"
        android:id="@+id/dateTimeTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Placeholder text"
        android:layout_alignParentStart="true"/>
    <TextView
        android:textAppearance="@style/TextAppearance.AppCompat.Body2"
        android:id="@+id/textView504"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/fabtah3"
        android:layout_below="@+id/dateTimeTextView"
        android:layout_alignParentStart="true"/>
    <Button
        android:textAppearance="@style/TextAppearance.AppCompat.Body2"
        android:id="@+id/button73"
        android:background="#00bfff"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:text="@string/text82"
        android:layout_below="@+id/textView504"
        android:layout_alignParentRight="true"
        android:onClick="newScreen"
        android:layout_alignParentEnd="true"/>
</RelativeLayout>

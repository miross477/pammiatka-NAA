    <string name="drm_dialog_message_apptouch_other_errorcode">வாங்குதல் வரலாற்றைச் சரிபார்க்க முடியவில்லை (பிழை %s). வாடிக்கையாளர் சேவையைத் தொடர்புகொள்ளவும்.</string>
    <string name="drm_dialog_message_check_failed">இந்தக் கணக்கைப் (%s) பயன்படுத்தி இந்தச் செயலி வாங்கப்படவில்லை. செயலியை வாங்கவும் அல்லது வேறொரு கணக்கிற்கு மாறவும்.</string>
    <string name="drm_dialog_message_check_failed_without_name">நீங்கள் இந்தச் செயலியை வாங்கவில்லை. இதை முதலில் வாங்கவும்.</string>
    <string name="drm_dialog_message_get_sign_failed">பிணைய பிழை. உங்கள் இணைய இணைப்பைச் சரிபார்த்து, மீண்டும் முயலவும்.</string>
    <string name="drm_dialog_message_hiapp_not_installed">முதலில் AppGallery-இன் சமீபத்திய பதிப்பை நிறுவவும்.</string>
    <string name="drm_dialog_message_no_internet">இணைய இணைப்பு இல்லை. உங்கள் இணைய இணைப்பைச் சரிபார்த்து, மீண்டும் முயலவும்.</string>
